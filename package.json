{
  "name": "carexplosion-art",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-art.mjs && vite dev",
    "build": "node scripts/prepare-art.mjs && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "node scripts/prepare-art.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "art:prepare": "node scripts/prepare-art.mjs",
    "art:import": "node scripts/import-art.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "sharp": "^0.35.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0"
  }
}
